# Contact form — SendGrid
SENDGRID_API_KEY=
CONTACT_TO_EMAIL=hello@aguilaritsolutions.com
CONTACT_FROM_EMAIL=hello@aguilaritsolutions.com

# Contact form — Cloudflare Turnstile (bot protection)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY is exposed to the browser; TURNSTILE_SECRET_KEY is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Contact form — Upstash Redis (server-side rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
